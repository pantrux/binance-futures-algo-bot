DATA_ROOT=/volume1/docker/binance-futures-algo-bot
POSTGRES_DB=tradingbot
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=change-me
API_PORT=8010
WEB_PORT=3012
OUTLINE_API_URL=http://192.168.0.8:3005/api
OUTLINE_API_TOKEN=
BINANCE_API_KEY=
BINANCE_API_SECRET=
DEFAULT_CAPITAL_USDT=1000
MAX_ACCOUNT_RISK_PCT=5
RISK_PER_TRADE_PCT=1
PAPER_TRADING=true
OPERATIONAL_CUTOVER_AT=
RUNTIME_MODE=oneshot
POLL_INTERVAL_SECONDS=30
MAX_CYCLES=0
TIMEFRAMES=5m,15m,1h
DEFAULT_SIGNAL_TIMEFRAME=15m
API_BASE_URL=http://api:8000
SYNOLOGY_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://IP_NAS:8010
